# PostgreSQL (new local database; restore your existing backup separately)
POSTGRES_DB=asadres
POSTGRES_USER=asadres
# Use a long random alphanumeric password to avoid URL-encoding issues.
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# Backend security: generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_WITH_64_HEX_CHARACTERS

# DNS A records for both domains must point to this VPS.
FRONTEND_DOMAIN=example.com
API_DOMAIN=api.example.com
PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_API_URL=https://api.example.com

# Browser Yandex Maps key (restrict it to the frontend domain in Yandex settings).
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
YANDEX_GEOCODER_API_KEY=

# Telegram admin login confirmation: keep your existing bot token and IDs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_USER_ID=
TELEGRAM_WEBHOOK_SECRET=

# Separate developer bot for remote session termination.
DEVELOPER_BOT_TOKEN=
DEVELOPER_TELEGRAM_ID=
DEVELOPER_BOT_SECRET=

# Allowed public frontend origins, comma-separated if there are several.
CORS_ORIGINS=https://example.com,https://www.example.com

# New photos are stored in the persistent property_images Docker volume.
MAX_IMAGE_SIZE_BYTES=15728640
